# ============================================================================
# FlashMind AI — Variáveis de Ambiente
# Copie este arquivo para `.env` e preencha o que for usar.
# Nenhuma chave é obrigatória sozinha — configure ao menos 1 provedor de IA
# (recomendado: GEMINI_API_KEY + GROQ_API_KEY) para habilitar geração por IA.
# Sem nenhuma chave configurada, o app ainda funciona com o gerador local
# de fallback (sem IA real) — veja docs/AI_PROVIDERS.md.
# ============================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# --- Provedores de IA gratuitos (configure ao menos 1) ---
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY="AQ.Ab8RN6LolsZnZqQ3YhvBN6i5QEPkgvVVqRf8SP6bUwB0rfZfGw"
GEMINI_MODEL="gemini-2.5-flash"

# Groq — https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# Hugging Face — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.1-8B-Instruct"

# Cohere — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=""
COHERE_MODEL="command-r"

# --- Provedor pago opcional (upgrade) ---
# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Defina como "true" para priorizar o provedor pago sobre os gratuitos.
AI_PRIORITIZE_PAID="false"

# --- Firebase Admin SDK (necessário para o programa de indicação) ---
# Console do Firebase > Configurações do Projeto > Contas de Serviço > Gerar nova chave
# Veja docs/FIREBASE_SETUP.md para o passo a passo completo.
FIREBASE_PROJECT_ID="appborala-e8c51"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Notificações Push (Firebase Cloud Messaging) ---
# Console do Firebase > Configurações do Projeto > Cloud Messaging >
# Web Push certificates > Gerar par de chaves. Veja docs/PUSH_NOTIFICATIONS.md
VITE_FIREBASE_VAPID_KEY=""
