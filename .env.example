# =============================================================================
# FlashMind AI — .env.example
# =============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# Em produção, configure essas variáveis como secrets da sua plataforma.
# =============================================================================

# ─── SERVIDOR ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# IA — GERAÇÃO DE FLASHCARDS (orquestrador com fallback automático)
# Configure pelo menos 1. Recomendado: Gemini (principal) + OpenAI ChatGPT (fallback).
# Quanto mais provedores, maior a resiliência.
# =============================================================================

# ─── GRATUITA (PRINCIPAL) ────────────────────────────────────────────────────

# 1. Google Gemini ★ PROVEDOR PRINCIPAL (gratuito) ★
#    → https://aistudio.google.com/app/apikey
#    Usado também para OCR/visão de imagens no Scanner.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

# ─── PAGA (FALLBACK IMEDIATO) ────────────────────────────────────────────────

# 2. OpenAI ChatGPT — usado como fallback imediato quando o Gemini falhar.
#    → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Groq (rápido, gratuito, tem visão)
#    → https://console.groq.com/keys
#    Usado também para OCR de imagens no Scanner (llama-3.2-11b-vision-preview).
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter (agrega modelos gratuitos)
#    → https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# 5. DeepSeek
#    → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 6. Hugging Face
#    → https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# 7. Cohere
#    → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r

# FreeLLM (sem chave necessária, qualidade variável)
FREELLM_ENABLED=false
FREELLM_MODEL=llama3-8b

# ─── PAGA (rede de segurança extra) ──────────────────────────────────────────

# Anthropic Claude
#    → https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Mover provedores pagos para o início da fila (recomendado em produção)
AI_PRIORITIZE_PAID=false

# =============================================================================
# OCR — SCANNER DE DOCUMENTOS E FOTOS
# Usado pelo endpoint /api/gemini/scanner-process para extrair texto de imagens.
# Ordem de fallback: Gemini Vision → Groq Vision → OCR.space
# Se GEMINI_API_KEY ou GROQ_API_KEY já estiverem configurados acima,
# o OCR funciona automaticamente sem nenhuma configuração extra.
# =============================================================================

# OCR.space — fallback final de OCR (25.000 req/mês grátis)
#    → https://ocr.space/ocrapi/freekey  (cadastro gratuito por e-mail)
#    Sem esta chave, usa 'helloworld' (chave pública, limitada a 3 req/hora).
OCRSPACE_API_KEY=

# =============================================================================
# FIREBASE
# =============================================================================

# ─── Admin SDK (back-end) ────────────────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Contas de Serviço → Gerar chave
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Client SDK (front-end / Vite) ───────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Seus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# FCM push notifications (Firebase Console → Cloud Messaging → VAPID)
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# ADMOB (monetização — opcional)
# Valores vazios usam os defaults de teste em src/lib/adMobConfig.ts.
# =============================================================================
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=

# =============================================================================
# FRONT-END (variáveis expostas ao browser via Vite — prefixo VITE_)
# Essas são opcionais: o front-end usa o servidor como proxy para a IA.
# Só preencha se quiser que o browser chame a IA diretamente como fallback.
# =============================================================================
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=deepseek/deepseek-r1:free
