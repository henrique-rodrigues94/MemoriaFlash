# =============================================================================
# MemoriaFlash — .env.example
# =============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# Em produção, configure essas variáveis como secrets da sua plataforma.
# =============================================================================

# ─── SERVIDOR ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# IA — GERAÇÃO DE FLASHCARDS (orquestrador com fallback automático)
# Provedores: Google Gemini (principal) + OpenAI ChatGPT (fallback).
# =============================================================================

# 1. Google Gemini ★ PROVEDOR PRINCIPAL (gratuito) ★
#    → https://aistudio.google.com/app/apikey
#    Usado também para OCR/visão de imagens no Scanner.
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

# 2. OpenAI ChatGPT — fallback imediato quando o Gemini falhar.
#    → https://platform.openai.com/api-keys
#    Preencha OPENAI_API_KEY com sua chave (sk-...) para ativar o fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# OCR — SCANNER DE DOCUMENTOS E FOTOS
# Usado pelo endpoint /api/gemini/scanner-process para extrair texto de imagens.
# O Gemini (GEMINI_API_KEY acima) realiza o OCR automaticamente.
# =============================================================================

# OCR.space — fallback final de OCR (25.000 req/mês grátis)
#    → https://ocr.space/ocrapi/freekey  (cadastro gratuito por e-mail)
#    Sem esta chave, usa 'helloworld' (chave pública, limitada a 3 req/hora).
OCRSPACE_API_KEY=

# =============================================================================
# FIREBASE
# =============================================================================

# ─── Admin SDK (back-end) ────────────────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Contas de Serviço → Gerar chave
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Client SDK (front-end / Vite) ───────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Seus apps → Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# FCM push notifications (Firebase Console → Cloud Messaging → VAPID)
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# ADMOB (monetização — opcional)
# Valores vazios usam os defaults de teste em src/lib/adMobConfig.ts.
# =============================================================================
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=

# =============================================================================
# FRONT-END (variáveis expostas ao browser via Vite — prefixo VITE_)
# Essas são opcionais: o front-end usa o servidor como proxy para a IA.
# Só preencha se quiser que o browser chame a IA diretamente como fallback.
# =============================================================================
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
