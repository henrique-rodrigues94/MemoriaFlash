# =============================================================================
# FlashMind AI — .env.example
# =============================================================================
# Copie para .env e preencha com suas chaves reais.
# O .env NUNCA deve ser commitado (já está no .gitignore).
# =============================================================================

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── IA GRATUITAS ────────────────────────────────────────────────────────────

# Google Gemini → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

# Groq → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# DeepSeek → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Hugging Face → https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Cohere → https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r

# FreeLLM (sem chave necessária) → https://freellm.com
FREELLM_ENABLED=false
FREELLM_MODEL=llama3-8b

# ─── IA PAGAS (opcionais) ────────────────────────────────────────────────────

# OpenAI → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude → https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Priorizar pagas (true = usa pagas primeiro)
AI_PRIORITIZE_PAID=false

# ─── FIREBASE / BANCO DE DADOS ───────────────────────────────────────────────

# Admin SDK → Firebase Console > Configurações > Contas de Serviço
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client SDK (front-end)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# ─── ADMOB ───────────────────────────────────────────────────────────────────
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=
