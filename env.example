# =============================================================================
# MemoriaFlash — .env.example
# =============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# Em produção, configure essas variáveis como secrets da sua plataforma.
# =============================================================================

# ─── SERVIDOR ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Token admin para o endpoint de manutenção POST /api/ai/reset-cooldowns.
# Sem esta variável, o endpoint fica desativado (503). Envie no header:
#   x-admin-token: <valor>
ADMIN_TOKEN=

# =============================================================================
# IA — GERAÇÃO DE FLASHCARDS (orquestrador com fallback automático)
#
# Provedores suportados (ordem de tentativa):
#   1. Google Gemini  (gratuito)       — PRINCIPAL
#   2. DeepSeek V3    (pago, barato)   — SEGUNDO
#   3. OpenAI ChatGPT (pago)           — TERCEIRO (fallback de alta qualidade)
#
# O primeiro provedor configurado E disponível que responder vence.
# Provedores sem chave preenchida são ignorados automaticamente.
# =============================================================================

# ─── 1. Google Gemini ★ PROVEDOR PRINCIPAL (gratuito) ★ ──────────────────────
#    Crie sua chave GRATUITA em: https://aistudio.google.com/app/apikey
#    Usado para geração de flashcards, currículos, níveis e OCR do Scanner.
#
#    Modelos recomendados:
#      gemini-2.5-flash  — padrão, rápido, suporte a 65k tokens de saída
#      gemini-2.5-pro    — maior qualidade, mais lento
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768

# ─── 2. DeepSeek V3 (pago, custo baixíssimo ~$0.27/1M tokens input) ──────────
#    Crie sua chave em: https://platform.deepseek.com/api_keys
#    Preencha DEEPSEEK_API_KEY para ativar. Deixe vazio para desativar.
#
#    Modelos recomendados:
#      deepseek-chat      — padrão (V3), melhor custo-benefício
#      deepseek-reasoner  — raciocínio avançado (R1), mais lento e caro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000

# ─── 3. OpenAI ChatGPT (pago, fallback de alta qualidade) ────────────────────
#    Crie sua chave em: https://platform.openai.com/api-keys
#    Preencha OPENAI_API_KEY para ativar. Deixe vazio para desativar.
#
#    Modelos recomendados:
#      gpt-4o-mini  — padrão, barato, ótimo custo-benefício
#      gpt-4o       — maior qualidade, mais caro
#      gpt-4.1-mini — intermediário
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25000

# =============================================================================
# OCR — SCANNER DE DOCUMENTOS E FOTOS
# O Gemini (GEMINI_API_KEY acima) realiza OCR automaticamente via visão.
# OCR.space é um fallback extra opcional.
# =============================================================================

# OCR.space — fallback de OCR (25.000 req/mês grátis)
#    → https://ocr.space/ocrapi/freekey  (cadastro gratuito por e-mail)
#    Sem esta chave, usa 'helloworld' (chave pública, limitada a 3 req/hora).
OCRSPACE_API_KEY=

# =============================================================================
# FIREBASE — BANCO DE DADOS E AUTENTICAÇÃO
# =============================================================================

# ─── Admin SDK (back-end / servidor) ─────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Contas de Serviço → Gerar nova chave privada
# O arquivo JSON gerado contém os 3 valores abaixo.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Cole a chave privada entre aspas duplas — mantenha as quebras de linha como \n
FIREBASE_PRIVATE_KEY=

# ─── Client SDK (front-end / Vite) ───────────────────────────────────────────
# Firebase Console → Configurações do Projeto → Seus apps → Web → Configuração do SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# FCM push notifications (Firebase Console → Cloud Messaging → Certificados da Web Push → VAPID)
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# ADMOB — MONETIZAÇÃO (opcional)
# Valores vazios usam os IDs de teste do Google automaticamente.
# Configure apenas para build de produção.
# =============================================================================
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=

# =============================================================================
# FRONT-END — variáveis expostas ao browser via Vite (prefixo VITE_)
# Opcionais: só preencha se quiser que o browser chame a IA diretamente
# como fallback quando o servidor estiver indisponível.
# ATENÇÃO: chaves VITE_ ficam visíveis no bundle JS do cliente.
# =============================================================================
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
