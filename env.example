# =============================================================================
# MemoriaFlash — .env.example
# =============================================================================
# Copie este arquivo para .env e preencha com suas chaves reais.
#
#   cp .env.example .env
#
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).
# Em produção, configure essas variáveis como secrets da sua plataforma.
# =============================================================================

# ─── SERVIDOR ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_TOKEN=

# =============================================================================
# IA — GERAÇÃO DE FLASHCARDS
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25000

# =============================================================================
# OCR
# =============================================================================
OCRSPACE_API_KEY=

# =============================================================================
# FIREBASE
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# ADMOB — MONETIZAÇÃO ANDROID
#
# Em desenvolvimento, se os IDs estiverem vazios, o código usa SOMENTE os IDs
# oficiais de teste do Google. Em produção, todos os IDs abaixo devem ser reais.
# Nunca coloque IDs de produção diretamente no código-fonte.
# =============================================================================
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=

# =============================================================================
# GOOGLE PLAY BILLING — BACKEND
# =============================================================================
# Application ID exatamente igual ao cadastrado no Play Console.
ANDROID_PACKAGE_NAME=com.memoriaflash.app
# Prefira secret manager/variável protegida em produção.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Alternativa para ambiente com arquivo montado:
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE=

# =============================================================================
# FRONT-END — variáveis expostas ao browser via Vite
# =============================================================================
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
