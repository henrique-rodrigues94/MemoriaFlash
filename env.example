# =============================================================================
# MemoriaFlash — .env.example
# =============================================================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_TOKEN=

# =============================================================================
# APP MOBILE — API E GOOGLE SIGN-IN
# No Android/Capacitor, VITE_API_BASE_URL deve apontar para o backend Express.
# Em desenvolvimento local use o IP da máquina na rede, por exemplo:
# VITE_API_BASE_URL=http://192.168.1.100:3000
# Em produção use HTTPS, por exemplo https://api.seudominio.com
# =============================================================================
VITE_API_BASE_URL=
VITE_GOOGLE_WEB_CLIENT_ID=

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25000

# OCR
OCRSPACE_API_KEY=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_VAPID_KEY=

# =============================================================================
# ADMOB — ANDROID
# Vazios em desenvolvimento => IDs oficiais de teste. Em produção => IDs reais.
# =============================================================================
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=

# =============================================================================
# GOOGLE PLAY BILLING — CLIENTE
# IDs precisam ser exatamente os produtos/base plans criados no Play Console.
# =============================================================================
VITE_PLAY_MONTHLY_PRODUCT_ID=
VITE_PLAY_MONTHLY_BASE_PLAN_ID=
VITE_PLAY_ANNUAL_PRODUCT_ID=
VITE_PLAY_ANNUAL_BASE_PLAN_ID=

# GOOGLE PLAY BILLING — BACKEND
ANDROID_PACKAGE_NAME=com.memoriaflash.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE=

# Front-end IA (exposto ao browser; não coloque aqui segredos de produção)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
