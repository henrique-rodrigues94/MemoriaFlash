# =============================================================================
# MemoriaFlash — .env.example
# =============================================================================
NODE_ENV=development
VITE_APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_TOKEN=

# APP MOBILE — API E GOOGLE SIGN-IN
VITE_API_BASE_URL=
VITE_GOOGLE_WEB_CLIENT_ID=
# URL pública usada nos links de indicação. Nunca deixe apontar para localhost.
VITE_PUBLIC_REFERRAL_URL=https://flashcardsia-a2f43.web.app

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=32768
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=25000

# OCR
OCRSPACE_API_KEY=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_VAPID_KEY=

# ADMOB — ANDROID
# Produção exige os IDs reais. Para homologação, defina VITE_ADMOB_USE_TEST_IDS=true.
VITE_ADMOB_USE_TEST_IDS=false
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_AD_UNIT_ID=
VITE_ADMOB_INTERSTITIAL_AD_UNIT_ID=
VITE_ADMOB_REWARDED_AD_UNIT_ID=
VITE_ADMOB_NATIVE_AD_UNIT_ID=
# Opcional para testes: IDs dos aparelhos separados por vírgula.
VITE_ADMOB_TEST_DEVICE_IDS=

# GOOGLE PLAY BILLING — CLIENTE
VITE_PLAY_MONTHLY_PRODUCT_ID=
VITE_PLAY_MONTHLY_BASE_PLAN_ID=
VITE_PLAY_ANNUAL_PRODUCT_ID=
VITE_PLAY_ANNUAL_BASE_PLAN_ID=

# GOOGLE PLAY BILLING — BACKEND
ANDROID_PACKAGE_NAME=com.memoriaflash.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_PLAY_RTDN_TOKEN=

# Front-end IA (exposto ao browser; não coloque aqui segredos de produção)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
