rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function protectedUserStatsFields() {
      return ['isPro','proPlanType','proExpiryDate','playPurchaseToken','playProductId','billingLastVerifiedAt','aiCardsGenerated'];
    }

    function clientStatsWriteAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserStatsFields());
    }

    function clientStatsCreateAllowed() {
      return (!request.resource.data.keys().hasAny(['proPlanType','proExpiryDate','playPurchaseToken','playProductId','billingLastVerifiedAt','aiCardsGenerated']))
        && (!request.resource.data.keys().hasAny(['isPro']) || request.resource.data.isPro == false);
    }

    match /decks/{deckId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /userStats/{statsId} {
      allow read: if isOwner(statsId);
      allow create: if isOwner(statsId) && clientStatsCreateAllowed();
      allow update: if isOwner(statsId) && clientStatsWriteAllowed();
    }

    match /classes/{classId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /notificationPrefs/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Conteúdo compartilhado é escrito exclusivamente pelo Admin SDK.
    // O cliente nunca pode alterar currículo, catálogo ou banco global.
    match /subjects/{id} { allow read: if true; allow write: if false; }
    match /curricula/{id} { allow read: if true; allow write: if false; }
    match /cardBuckets/{id} { allow read: if true; allow write: if false; }
    match /contentCatalog/{id} { allow read: if true; allow write: if false; }
    match /aiCache/{id} { allow read, write: if false; }

    match /feedback/{feedbackId} { allow read, write: if false; }
    match /referralCodes/{code} { allow read, write: if false; }
    match /referrals/{uid} { allow read, write: if false; }
  }
}
