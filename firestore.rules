rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn(){return request.auth!=null;}
    function isOwner(uid){return isSignedIn()&&request.auth.uid==uid;}
    function protectedUserStatsFields(){return ['isPro','proPlanType','proExpiryDate','playPurchaseToken','playProductId','billingLastVerifiedAt','aiCardsGenerated','referralCount','referralProDaysEarned','referredByCode'];}
    function clientStatsWriteAllowed(){return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserStatsFields());}
    function clientStatsCreateAllowed(){return !request.resource.data.keys().hasAny(['proPlanType','proExpiryDate','playPurchaseToken','playProductId','billingLastVerifiedAt','aiCardsGenerated','referralCount','referralProDaysEarned','referredByCode'])&&(!request.resource.data.keys().hasAny(['isPro'])||request.resource.data.isPro==false);}
    function validComment(){return !request.resource.data.keys().hasAny(['comment'])||(request.resource.data.comment is string&&request.resource.data.comment.size()<=500);}
    function validCardProblem(){return isSignedIn()&&request.resource.data.cardId is string&&request.resource.data.cardId.size()>0&&request.resource.data.userId is string&&request.resource.data.userId==request.auth.uid&&request.resource.data.reportType=='card_problem'&&(!request.resource.data.keys().hasAny(['reason'])||request.resource.data.reason in ['wrong_answer','bad_explanation','confusing_question','duplicate_content','outdated_content','other'])&&validComment();}
    function validRatingFeedback(){return isSignedIn()&&request.resource.data.cardId is string&&request.resource.data.rating in ['positive','negative']&&validComment();}

    match /decks/{deckId}{
      allow read:if isSignedIn()&&resource.data.userId==request.auth.uid;
      allow create:if isSignedIn()&&request.resource.data.userId==request.auth.uid;
      allow update,delete:if isSignedIn()&&resource.data.userId==request.auth.uid;
    }
    match /userStats/{statsId}{allow read:if isOwner(statsId);allow create:if isOwner(statsId)&&clientStatsCreateAllowed();allow update:if isOwner(statsId)&&clientStatsWriteAllowed();}
    match /classes/{classId}{allow read:if true;allow create:if isSignedIn()&&request.resource.data.teacherId==request.auth.uid;allow update,delete:if isSignedIn()&&resource.data.teacherId==request.auth.uid;}
    match /notificationPrefs/{uid}{allow read,write:if isOwner(uid);}

    // Conteúdo compartilhado: leitura para usuários, escrita somente Admin SDK.
    match /subjects/{id}{allow read:if true;allow write:if false;}
    match /curricula/{id}{allow read:if true;allow write:if false;}
    match /cardBuckets/{id}{allow read:if true;allow write:if false;}
    match /contentIndex/{id}{allow read:if true;allow write:if false;}
    match /contentCatalog/{id}{allow read:if true;allow write:if false;}

    // Fila e métricas do Agent nunca são acessíveis pelo cliente.
    match /contentRequests/{id}{allow read,write:if false;}
    match /agentRuns/{id}{allow read,write:if false;}
    match /agentMetrics/{id}{allow read,write:if false;}
    match /agentErrors/{id}{allow read,write:if false;}
    match /aiCache/{id}{allow read,write:if false;}

    // Feedback: o usuário pode criar, mas nunca alterar/apagar. O relatório
    // de problema exige que o UID enviado corresponda ao usuário autenticado.
    match /cardFeedback/{id}{
      allow create:if validCardProblem()||validRatingFeedback();
      allow read,update,delete:if false;
    }
    match /feedback/{id}{allow read,write:if false;}
    match /referralCodes/{code}{allow read,write:if false;}
    match /referrals/{uid}{allow read,write:if false;}
  }
}
